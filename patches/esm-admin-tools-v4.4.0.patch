--- /dev/null
+++ b/packages/esm-reports-app/src/utils/openmrs-cron-utils.test.ts
@@ -0,0 +1,18 @@
+import { describe, expect, it } from 'vitest';
+import { toUnixDayOfWeekNumbering } from './openmrs-cron-utils';
+
+describe('toUnixDayOfWeekNumbering', () => {
+  it('shifts Quartz day-of-week numbers (Sunday = 1) to Unix numbers (Sunday = 0)', () => {
+    expect(toUnixDayOfWeekNumbering('0 30 7 ? * 2,5')).toBe('0 30 7 ? * 1,4');
+    expect(toUnixDayOfWeekNumbering('0 0 6 ? * 2-6')).toBe('0 0 6 ? * 1-5');
+    expect(toUnixDayOfWeekNumbering('0 0 6 ? * 1')).toBe('0 0 6 ? * 0');
+  });
+
+  it('leaves steps, nth occurrences, names and other fields alone', () => {
+    expect(toUnixDayOfWeekNumbering('0 0 6 ? * 6#3')).toBe('0 0 6 ? * 5#3');
+    expect(toUnixDayOfWeekNumbering('0 0 6 ? * 1/2')).toBe('0 0 6 ? * 0/2');
+    expect(toUnixDayOfWeekNumbering('0 0 6 ? * MON')).toBe('0 0 6 ? * MON');
+    expect(toUnixDayOfWeekNumbering('0 0 6 * * ?')).toBe('0 0 6 * * ?');
+    expect(toUnixDayOfWeekNumbering('0 30 8 16 3 ? 2026')).toBe('0 30 8 16 3 ? 2026');
+  });
+});
diff --git a/packages/esm-reports-app/src/utils/openmrs-cron-utils.ts b/packages/esm-reports-app/src/utils/openmrs-cron-utils.ts
index 361e559..b6cdf03 100644
--- a/packages/esm-reports-app/src/utils/openmrs-cron-utils.ts
+++ b/packages/esm-reports-app/src/utils/openmrs-cron-utils.ts
@@ -24,3 +24,21 @@ export function parseOpenMRSCron(expression: string): OpenMRSCron {
     year: tokens[6],
   };
 }
+
+/**
+ * Quartz numbers the days of the week from 1 (Sunday) to 7 (Saturday), while cronjs-parser
+ * uses the Unix numbering from 0 (Sunday). Shift the day-of-week numbers so that the next
+ * execution is calculated for the same days the server runs the report on.
+ * Step values (`/n`) and nth-occurrence values (`#n`) are not day numbers and are left alone.
+ */
+export function toUnixDayOfWeekNumbering(expression: string): string {
+  const tokens = expression.trim().split(/\s+/);
+  if (tokens.length < 6) {
+    return expression;
+  }
+  tokens[5] = tokens[5].replace(
+    /(^|[^/#\d])(\d+)/g,
+    (_, prefix: string, day: string) => `${prefix}${Number(day) - 1}`,
+  );
+  return tokens.join(' ');
+}
