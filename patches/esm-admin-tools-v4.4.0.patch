diff --git a/packages/esm-reports-app/src/utils/openmrs-cron-utils.ts b/packages/esm-reports-app/src/utils/openmrs-cron-utils.ts
index 361e559..b6cdf03 100644
--- a/packages/esm-reports-app/src/utils/openmrs-cron-utils.ts
+++ b/packages/esm-reports-app/src/utils/openmrs-cron-utils.ts
@@ -24,3 +24,21 @@ export function parseOpenMRSCron(expression: string): OpenMRSCron {
     year: tokens[6],
   };
 }
+
+/**
+ * Quartz numbers the days of the week from 1 (Sunday) to 7 (Saturday), while cronjs-parser
+ * uses the Unix numbering from 0 (Sunday). Shift the day-of-week numbers so that the next
+ * execution is calculated for the same days the server runs the report on.
+ * Step values (`/n`) and nth-occurrence values (`#n`) are not day numbers and are left alone.
+ */
+export function toUnixDayOfWeekNumbering(expression: string): string {
+  const tokens = expression.trim().split(/\s+/);
+  if (tokens.length < 6) {
+    return expression;
+  }
+  tokens[5] = tokens[5].replace(
+    /(^|[^/#\d])(\d+)/g,
+    (_, prefix: string, day: string) => `${prefix}${Number(day) - 1}`,
+  );
+  return tokens.join(' ');
+}
