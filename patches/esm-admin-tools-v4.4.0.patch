@@ -0,0 +1,24 @@
+import { describe, expect, it } from 'vitest';
+import { parameterPayload, parametersValid, structuredError, structuredTypes } from './structured-parameter';
+
+describe('structured parameter submission', () => {
+  for (const type of structuredTypes) {
+    it.each([undefined, null, '', '  \n\t'])('normalizes optional blank %s for ' + type, (value) => {
+      const parameters = [{ name: 'columns', type }];
+      expect(structuredError(value, type)).toBe('');
+      expect(parametersValid(parameters, { columns: value })).toBe(true);
+      expect(parameterPayload(parameters, { columns: value, memo: 'preserved' })).toEqual({ columns: [], memo: 'preserved' });
+      expect(parametersValid([{ ...parameters[0], required: true }], { columns: value })).toBe(false);
+    });
+  }
+  it('retains typed arrays and rejects malformed or wrong-shaped JSON', () => {
+    const type = structuredTypes[1];
+    const parameters = [{ name: 'sorts', type }];
+    const sorts = [{ column: 'ID', direction: 'ASC' }];
+    expect(parameterPayload(parameters, { sorts })).toEqual({ sorts });
+    expect(parameterPayload(parameters, { sorts: JSON.stringify(sorts) })).toEqual({ sorts });
+    for (const value of ['{bad', '{}', '[{"column":"ID","direction":"INVALID"}]']) {
+      expect(parametersValid(parameters, { sorts: value })).toBe(false);
+    }
+  });
+});
diff --git a/packages/esm-reports-app/src/components/structured-parameter.tsx b/packages/esm-reports-app/src/components/structured-parameter.tsx
new file mode 100644
index 0000000..aabb800
--- /dev/null
+++ b/packages/esm-reports-app/src/components/structured-parameter.tsx
@@ -0,0 +1,71 @@
+import React from 'react';
+import { TextArea } from '@carbon/react';
+
+export const structuredTypes = [
+  'org.openmrs.module.reporting.dataset.column.definition.RowPerObjectColumnDefinition',
+  'org.openmrs.module.reporting.common.SortCriteria',
+];
+
+export interface ParameterShape { name: string; type: string; label?: string; required?: boolean; }
+export function isStructured(type: string): boolean { return structuredTypes.includes(type); }
+export function structuredText(value: unknown): string {
+  return typeof value === 'string' ? value : value == null ? '' : JSON.stringify(value, null, 2);
+}
+export function structuredError(value: unknown, type?: string): string {
+  if (value == null || (typeof value === 'string' && !value.trim())) return '';
+  try {
+    const parsed: unknown = typeof value === 'string' ? JSON.parse(value) : value;
+    if (!Array.isArray(parsed) || parsed.some((item) => !item || typeof item !== 'object' || Array.isArray(item))) {
+      return 'Enter a JSON array of objects.';
+    }
+    const names = new Set<string>();
+    for (const item of parsed as Record<string, unknown>[]) {
+      const sort = type?.endsWith('.SortCriteria');
+      const allowed = sort ? ['column', 'direction'] : ['name', 'uuid', 'mappings', 'converters'];
+      if (Object.keys(item).some((key) => !allowed.includes(key))) return 'Remove unsupported object fields.';
+      const name = item[sort ? 'column' : 'name'];
+      if (typeof name !== 'string' || !name.trim() || names.has(name.trim())) return 'Use nonempty, unique column names.';
+      names.add(name.trim());
+      if (sort) {
+        if (!['ASC', 'DESC'].includes(String(item.direction))) return 'Sort direction must be ASC or DESC.';
+      } else {
+        if (typeof item.uuid !== 'string' || !item.uuid.trim()) return 'Each column needs a saved definition UUID.';
+        if (item.mappings != null && (typeof item.mappings !== 'object' || Array.isArray(item.mappings))) return 'Mappings must be an object.';
+        if (item.converters != null && (!Array.isArray(item.converters) || item.converters.some((converter) =>
+          !converter || typeof converter !== 'object' || typeof converter.type !== 'string' ||
+          Object.keys(converter).some((key) => !['type', 'properties'].includes(key)) ||
+          (converter.properties != null && (typeof converter.properties !== 'object' || Array.isArray(converter.properties)))))) return 'Converters need a type and properties object.';
+      }
+    }
+    return '';
+  } catch { return 'Enter a valid JSON array of objects.'; }
+}
+export function parametersValid(parameters: ParameterShape[], values: Record<string, unknown>): boolean {
+  return parameters.every((parameter) => {
+    const value = values[parameter.name];
+    const present = value != null && (typeof value !== 'string' || !!value.trim());
+    return (!parameter.required || present) &&
+      (!isStructured(parameter.type) || !structuredError(value, parameter.type));
+  });
+}
+export function parameterPayload(parameters: ParameterShape[], values: Record<string, unknown>): Record<string, unknown> {
+  const result = { ...values };
+  parameters.forEach((parameter) => {
+    const value = result[parameter.name];
+    if (isStructured(parameter.type) && (value == null || typeof value === 'string')) {
+      result[parameter.name] = typeof value === 'string' && value.trim() ? JSON.parse(value) : [];
+    }
+  });
+  return result;
+}
+export const StructuredParameterInput: React.FC<{
+  parameter: ParameterShape; value: unknown; onChange: (value: string) => void;
+}> = ({ parameter, value, onChange }) => {
+  const error = structuredError(value, parameter.type);
+  return <div style={{textAlign: 'left', width: '100%'}}><TextArea id={parameter.name} name={parameter.name} labelText={parameter.label || parameter.name}
+    rows={6} value={structuredText(value)} onChange={(event) => onChange(event.target.value)}
+    helperText={parameter.type.endsWith('.SortCriteria')
+      ? 'JSON sort rules: [{"column":"ID","direction":"DESC"}]. Directions: ASC or DESC. Use [] for no sorting.'
+      : 'JSON columns: [{"name":"ID","uuid":"<saved-definition-uuid>","mappings":{},"converters":[]}]. Use unique names, saved definition UUIDs and typed parameter mappings; [] means no columns.'}
+    invalid={!!error} invalidText={error} /></div>;
+};
